# Results fixtures are checked byte for byte (meta.json stores the sha256 of each raw file), so git must
# never convert their line endings (core.autocrlf would turn LF into CRLF on a Windows checkout).
tools/test/fixtures/results/** -text
# The CRLF README fixture must stay CRLF on every checkout (its test compares it with an LF twin).
tools/test/fixtures/md/README.crlf.md -text
# The rate limiter's WASM artifacts and the vendored parity fixtures are checked byte for byte against the
# sha256 in scripts/demos/wasm/ratelimit.manifest.json, so core.autocrlf must never convert them.
scripts/demos/wasm/** -text
tools/test/fixtures/ratelimit-parity/** -text
# The IQG demo's vendored Python sources and wheels, its parity fixtures and its sample images are checked byte for
# byte against scripts/demos/iqg-py/iqg.manifest.json, so core.autocrlf must never convert them.
scripts/demos/iqg-py/** -text
tools/test/fixtures/iqg-parity/** -text
static/demo/iqg/** -text
